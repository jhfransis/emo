[Unit]
Description=KONA Futures Streamlit UI
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=fransis
Group=fransis
WorkingDirectory=/home/fransis/project/kona
Environment=HOME=/home/fransis
Environment=PATH=/home/fransis/miniforge3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/fransis/miniforge3/bin/streamlit run app/kona_futures.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
